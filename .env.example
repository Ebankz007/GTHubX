# ---------------------------------------------------------------------------
# GTHubX (Global Traders HubX) environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3500"
NEXT_PUBLIC_SITE_NAME="Global Traders HubX"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_ME_32_BYTES_HEX"

# --- Phase 2+ (database) ---------------------------------------------------
# DATABASE_URL="postgresql://gthubx:CHANGE_ME@localhost:5433/gthubx?schema=public"
# TEST_DATABASE_URL="postgresql://gthubx:CHANGE_ME@localhost:5433/gthubx_test?schema=public"

# --- Phase 3+ (initial administrator) --------------------------------------
# ADMIN_EMAIL="admin@gthubx.com"
# ADMIN_PASSWORD="ChangeMe-Admin-123!"
# ADMIN_NAME="Global Traders HubX Admin"

# --- Integrations (optional — leave blank to disable) ----------------------
# Email (Resend). Blank API key = development logs the message instead of
# sending it, and production reports failure rather than faking success.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Global Traders HubX <no-reply@gthubx.com>"

# Payment rail (Pay2Crypto). Blank API URL + token = MOCK MODE in development
# (synthetic checkout URLs) and a hard 503 in production — there is no fake
# success in production. The webhook fails closed with no secret set.
# PAY2CRYPTO_API_URL="https://api.pay2crypto.com"
# PAY2CRYPTO_TOKEN=""
# PAY2CRYPTO_WEBHOOK_SECRET=""
# PAY2CRYPTO_ASSET="USDT"
# PAY2CRYPTO_NETWORK="trc20"

# Identity minimisation (Phase 7d). The platform does not store the document
# number a member types - only an HMAC-SHA256 digest of it (for duplicate
# detection) and its last four characters (as a human reference). This value is
# the key for that digest.
#
# Keep it secret, keep it out of the database, and keep it stable: rotating it
# makes existing digests uncomparable, so duplicate detection stops working for
# submissions made before the change. If it is UNSET the platform stores no
# digest at all rather than falling back to an unkeyed hash - losing a feature
# is preferable to holding a reversible copy of sensitive personal information.
# Generate one with: openssl rand -base64 36
# KYC_ID_PEPPER=""

# WHATSAPP_TOKEN="" TELEGRAM_BOT_TOKEN=""
# KYC_PROVIDER="" KYC_SECRET=""
