# ---------------------------------------------------------------------------
# GTHubX (Global Traders HubX) environment configuration
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3500"
NEXT_PUBLIC_SITE_NAME="Global Traders HubX"

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="CHANGE_ME_32_BYTES_HEX"

# --- Phase 2+ (database) ---------------------------------------------------
# DATABASE_URL="postgresql://gthubx:CHANGE_ME@localhost:5433/gthubx?schema=public"
# TEST_DATABASE_URL="postgresql://gthubx:CHANGE_ME@localhost:5433/gthubx_test?schema=public"

# --- Phase 3+ (initial administrator) --------------------------------------
# ADMIN_EMAIL="admin@gthubx.com"
# ADMIN_PASSWORD="ChangeMe-Admin-123!"
# ADMIN_NAME="Global Traders HubX Admin"

# --- Integrations (optional — leave blank to disable) ----------------------
# EMAIL_HOST="" EMAIL_PORT="587" EMAIL_USER="" EMAIL_PASSWORD=""
# EMAIL_FROM="Global Traders HubX <no-reply@gthubx.com>"
# PAYMENTS_PROVIDER="" PAYMENTS_SECRET=""
# WHATSAPP_TOKEN="" TELEGRAM_BOT_TOKEN=""
# KYC_PROVIDER="" KYC_SECRET=""
